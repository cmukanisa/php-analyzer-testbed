{
    "name": "cmukanisa/php-analyzer-testbed",
    "description": "Deliberate-defect testbed for PHP static analyzers — every probe ships with its expected verdict, verified by execution.",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.0",
        "symfony/dependency-injection": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "autoload": {"psr-4": {"Testbed\\": "src/"}},
    "autoload-dev": {"psr-4": {"Testbed\\Probes\\": "probes/"}},
    "config": {"sort-packages": true}
}
